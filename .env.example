# OpenAI API Key (optional - system works in mock/fallback mode without it)
OPENAI_API_KEY=your-key-here

# Database URL (defaults to sqlite+aiosqlite:///./backend/data/lpo.db)
DATABASE_URL=sqlite+aiosqlite:///./backend/data/lpo.db

# Email Ingestion (optional - disabled by default)
# Set EMAIL_ENABLED=true to activate automatic email polling
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_POLL_INTERVAL=5
